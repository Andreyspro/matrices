{
  "version": "2.0.0",
  "tasks": [
    // MTX Solver classic multithread debug
    {
      "type": "shell",
      "label": "task_MtxSolverClassic_build_dbg",
      "command": "/usr/bin/g++",
      "args": [
        "-Wall",
        "-std=c++11",
        // "-O2",
        "-g",
        "-I./src",
        "-I./mtxsolver",
        "-I./aux",
        "-I./and_net/and_net3/",

        "./src/*.cpp",
        "./mtxsolver/*.cpp",
        "./aux/*.cpp",
        "./and_net/and_net3/*.cpp",

        "-o",
        "./bin/mtx_solver_classic_dbg",
        "-lboost_filesystem",
        "-lpthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },

    // MTX Solver classic multithread release
    {
		"type": "shell",
		"label": "task_MtxSolverClassic_build_release",
		"command": "/usr/bin/g++",
		"args": [
		  "-Wall",
		  "-std=c++11",
		  "-O2",
		  "-I./src",
		  "-I./mtxsolver",
		  "-I./aux",
		  "-I./and_net/and_net3/",
  
		  "./src/*.cpp",
		  "./mtxsolver/*.cpp",
		  "./aux/*.cpp",
		  "./and_net/and_net3/*.cpp",

		  "-o",
		  "./bin/mtx_solver_classic_release",
		  "-lboost_filesystem",
		  "-lpthread"
		],
		"options": {
		  "cwd": "${workspaceFolder}"
		},
		"problemMatcher": [
		  "$gcc"
		],
		"group": {
		  "kind": "build",
		  "isDefault": true
		},
	  },

    // mtx WORKER debug compile
    {
      "type": "shell",
      "label": "task_mtx_worker_build_dbg",
      "command": "/usr/bin/g++",
      "args": [
        "-Wall",
        "-std=c++11",
        "-g",

        "-I./worker",
        "-I./mtxsolver",
        "-I./mtxsolver/async",
        "-I./aux",
        "-I./and_net/and_net3",
        "-I./net_handler",
        
        "./worker/*.cpp",
        "./mtxsolver/async/*.cpp",
        "./mtxsolver/*.cpp",
        "./and_net/and_net3/*.cpp",
        "./net_handler/*.cpp",
        "./aux/*.cpp",

        "-o",
        "./bin/mtx_worker_dbg",
        "-lboost_filesystem",
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },
